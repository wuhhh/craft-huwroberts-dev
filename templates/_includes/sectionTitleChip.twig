{% set title = title ?? null %}
{% set chipLabel = chipLabel ?? null %}
{% set chipLink = chipLink ?? null %}
{% set classes = classes ?? '' %}

{% if title and chipLabel and chipLink %}
  <div
    class="flex flex-col items-center gap-y-4 text-center font-mono text-xs uppercase {{ classes }}"
  >
    <h2 class="font-mono text-sm leading-none uppercase">{{ title }}</h2>
    <a
      class="inline-block rounded-full border border-black px-2.5 py-1.75 font-mono text-sm leading-none uppercase transition-colors duration-100 hover:bg-black hover:text-white"
      href="{{ chipLink }}"
    >
      {{ chipLabel }}
    </a>
  </div>
{% endif %}
