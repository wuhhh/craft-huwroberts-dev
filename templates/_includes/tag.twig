{% set tag = tag ?? null %}

{% if tag %}
  <li
    class="flex h-[45px] flex-shrink-0 items-center justify-center rounded-full bg-black px-5 font-sans text-base font-medium whitespace-nowrap text-white md:h-14 md:px-6 md:text-[18px] md:font-bold"
  >
    <span class="relative z-10">{{ tag }}</span>
  </li>
{% endif %}
