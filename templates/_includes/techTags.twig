{% set techTags = techTags ?? [] %}
{% set id = id ?? 'tech-tags' %}

{% if techTags|length %}
  <div
    class="no-scrollbar fade-end xs-mono flex w-full gap-x-4 gap-y-2 overflow-x-scroll text-zinc-500"
  >
    <h3 id="{{ id }}-label" class="flex shrink-0 items-center gap-x-0.5">
      {{ svg('@webroot/dist/images/icon--hash.svg', true, true)|attr({ class: 'shrink-0' }) }}
      <span class="shrink-0">Tags:</span>
    </h3>
    <ul aria-labelledby="{{ id }}-label" class="m-0 flex list-none gap-x-4 gap-y-2 p-0">
      {% for techTag in techTags %}
        <li class="inline-block shrink-0">{{ techTag }}</li>
      {% endfor %}
    </ul>
  </div>
{% endif %}
