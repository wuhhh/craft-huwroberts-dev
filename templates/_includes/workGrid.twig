{% set entries = entries ?? craft.entries.section('work').with(['imageAsset']).all() %}

{% if entries|length %}
  {# Work card grid #}
  <div class="col-span-full grid grid-cols-subgrid gap-y-24">
    {% for entry in entries %}
      {% set image = entry.imageAsset.one() ?? null %}
      {% set cls = '' %}

      {% set base6Index0 = loop.index0 % 6 %}

      {# Vertical spacing #}
      {% if base6Index0 == 1 or base6Index0 == 4 or base6Index0 == 5 %}
        {% set cls = 'ml-auto lg:ml-0' %}
      {% endif %}

      {# Horizontal spacing #}
      {% set blank %}
        <div class="hidden xl:col-span-4 xl:block"></div>
      {% endset %}

      {% if base6Index0 == 2 %}
        {{ blank }}{{ blank }}
      {% elseif base6Index0 == 5 %}
        {{ blank }}
      {% endif %}

      <div
        class="group relative col-span-full w-full max-w-120 space-y-4 lg:col-span-6 lg:max-w-none xl:col-span-4 {{
        cls
        }}"
      >
        {% if image %}
          <div
            class="border-smoke {# #} relative aspect-480/288 shadow-sm transition-all duration-200 group-hover:shadow-none lg:border-x"
          >
            {{
              image.getImg(
                { width: 480, height: 288, format: 'avif', mode: 'crop' },
                ['480w', '960w', '1440w']
              )|attr({
                sizes: '(max-width: 480px) 100vw, (min-width: 1280px) 700px, 480px',
                class: 'object-cover w-full h-full rounded-sm sm:rounded-none',
                alt: ''
              })
            }}
            <div
              class="absolute inset-0 bg-zinc-100/90 opacity-0 backdrop-brightness-125 backdrop-saturate-0 transition-opacity duration-200 group-hover:opacity-100"
            ></div>
          </div>
        {% endif %}

        <div class="flex flex-col gap-y-2">
          <h2 class="base-sans">{{ entry.title }}</h2>
          {% include '_includes/workCardMeta' with {
            class: 'sm-mono leading-tight',
            type: entry.workType,
            year: entry.year,
            agency: entry.agency
          } %}
        </div>

        <a
          href="{{ url(entry.uri) }}"
          data-follower="more"
          class="box-link focus-visible:before:outline-coral-red focus-visible:outline-0 focus-visible:before:outline-2 focus-visible:before:outline-offset-2"
          aria-label="{{ '{0} project details, opens modal'|t([entry.title]) }}"
        >

        </a>
      </div>
    {% endfor %}
  </div>
{% endif %}
