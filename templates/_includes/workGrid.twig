{% set entries = entries ?? craft.entries.section('work').with(['imageAsset']).all() %}

{% if entries|length %}

  {# Work card grid #}
  <div class="col-span-full grid grid-cols-subgrid gap-y-24">
    {% for entry in entries %}

      {% set cls = "" %}

      {% set base6Index0 = loop.index0 % 6 %}

      {# Vertical spacing #}
      {% if base6Index0 == 1 or base6Index0 == 4 or base6Index0 == 5 %}
        {% set cls = "ml-auto lg:ml-0" %}
      {% endif %}

      {# Horizontal spacing #}
      {% set blank %}
        <div class="hidden xl:block xl:col-span-4"></div>
      {% endset %}

      {% if base6Index0 == 2 %}
        {{ blank }}{{ blank }}
      {% elseif base6Index0 == 5 %}
        {{ blank }}
      {% endif %}


      <div class="col-span-full w-full max-w-120 lg:max-w-none lg:col-span-6 xl:col-span-4 {{ cls }}">
        {% embed "_includes/entryCard" with {
          entry: entry,
          sizes: "(max-width: 480px) 100vw, (min-width: 1280px) 700px, 480px",
          linkLabel: '{0} project details, opens modal'|t([entry.title]),
          follower: "more",
          showTags: false,
        } only %}
          {% block metaStart %}
            {% include "_includes/workCardMeta" with {
              type: entry.workType,
              agency: entry.agency,
            } only %}
          {% endblock %}
        {% endembed %}
      </div>

    {% endfor %}
  </div>

{% endif %}

