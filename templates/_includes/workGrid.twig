{% set entries = entries ?? craft.entries.section('work').with(['imageAsset']).all() %}

{% embed '_includes/entryGrid' with { entries: entries } only %}
  {% block card %}
    {% embed '_includes/entryCard'
      with {
        entry: entry,
        sizes: '(max-width: 480px) 100vw, (min-width: 1280px) 700px, 480px',
        linkLabel: '{0} project details, opens modal'|t([entry.title]),
        follower: 'more',
        showTags: false
      } only
    %}
      {% block metaStart %}
        {% include '_includes/workCardMeta' with {
          type: entry.workType,
          agency: entry.agency
        } only %}
      {% endblock %}
    {% endembed %}
  {% endblock %}
{% endembed %}
