{% set url = url ?? null %}

<a
  data-loading-indicator
  class="bg-stone inline-flex -translate-y-0.5 items-center gap-x-1.75 rounded-full py-1 pr-3 pl-2 text-black transition-colors duration-200 hover:bg-transparent sm:py-1.5 sm:pr-4 sm:pl-3 lg:mt-1 lg:translate-y-0"
  href="{{ url }}"
  rel="noopener noreferrer"
>
  <span class="bg-seabed-indigo mr-0.5 size-2.75 rounded-full"></span>
  <span class="font-mono text-xs leading-normal uppercase sm:text-[13px]">View Live</span>
  {{ svg('@webroot/dist/images/icon--external-link.svg', true, true)|attr({ class: 'size-3' }) }}
</a>
