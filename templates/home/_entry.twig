{% extends '_layouts/scene' %}

{% block content %}
  <div class="col-span-full mb-16">
    <intro-scene class="sm-down:w-screen sm-down:-ml-6">
      <intro-scene-decor></intro-scene-decor>
      <intro-scene-text
        line-1="{{ entry.introLine1 ?? '' }}"
        line-2="{{ entry.introLine2 ?? '' }}"
        line-3="{{ entry.introLine3 ?? '' }}"
        line-4="{{ entry.introLine4 ?? '' }}"
      ></intro-scene-text>
    </intro-scene>
  </div>

  {# == Featured Work == #}

  {% set workTitle = entry.workTitle ?? null %}
  {% set workCtaChip = entry.workCtaChip ?? null %}

  {% if workTitle and workCtaChip.url %}
    <div class="col-span-full">
      {% include '_includes/sectionTitleChip.twig' with {
        title: workTitle,
        chipLabel: workCtaChip.label ?? 'View All',
        chipLink: workCtaChip.url,
        classes: 'mb-16'
      } only %}
    </div>
  {% endif %}

  {% include '_includes/workGrid' with { entries: entry.workEntries ?? [] } only %}

  <div class="relative col-span-full my-26 h-screen md:my-32 xl:my-38">
    {% set aboutUrl = craft.entries.section('about').one().url ?? null %}

    <about-huw-scene class="sm-down:w-screen sm-down:-ml-6">
      <div class="flex flex-col items-center text-center font-mono text-sm uppercase">
        {{
          svg('@webroot/dist/images/icon--eye-can-see-you.svg', true, true)|attr({
            class: 'mb-4 w-12',
            'aria-hidden': 'true'
          })
        }}
        <p class="leading-snug">
          Huw is a versatile, creative<br />developer from Wales in the UK
        </p>
        {% if aboutUrl %}
          <a
            class="mt-4 inline-block rounded-full border border-black px-2.5 py-1.75 leading-none transition-colors duration-100 hover:bg-black hover:text-white"
            href="{{ aboutUrl }}"
          >
            Read more
          </a>
        {% endif %}
      </div>
    </about-huw-scene>
  </div>

  {# == Featured Journal == #}

  {% set journalTitle = entry.journalTitle ?? null %}
  {% set journalCtaChip = entry.journalCtaChip ?? null %}
  {% set journalEntries = entry.journalEntries.with(['imageAsset']).all() ?? [] %}

  {% if journalEntries|length %}
    {% if journalTitle and journalCtaChip.url %}
      <div class="col-span-full">
        {% include '_includes/sectionTitleChip.twig' with {
          title: journalTitle,
          chipLabel: journalCtaChip.label ?? 'View All',
          chipLink: journalCtaChip.url,
          classes: 'mb-16'
        } only %}
      </div>
    {% endif %}

    {% embed '_includes/entryGrid' with { entries: journalEntries } only %}
      {% block card %}
        {% include '_includes/journalCard' with {
          entry: entry,
          featured: false,
          showTags: false,
          sizes: '(max-width: 480px) 100vw, (min-width: 1280px) 700px, 480px'
        } only %}
      {% endblock %}
    {% endembed %}
  {% endif %}
{% endblock %}
