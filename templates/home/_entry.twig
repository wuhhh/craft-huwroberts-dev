{% extends '_layouts/scene' %}

{% block content %}
  <div class="col-span-full mb-16">
    <intro-scene class="sm-down:w-screen sm-down:-ml-6">
      <intro-scene-decor></intro-scene-decor>
      <intro-scene-text
        line-1="{{ entry.introLine1 ?? '' }}"
        line-2="{{ entry.introLine2 ?? '' }}"
        line-3="{{ entry.introLine3 ?? '' }}"
        line-4="{{ entry.introLine4 ?? '' }}"
      ></intro-scene-text>
    </intro-scene>
  </div>

  {# == Featured Work == #}

  {% set workTitle = entry.workTitle ?? null %}
  {% set workCtaChip = entry.workCtaChip ?? null %}

  {% if workTitle and workCtaChip.url %}
    <div class="col-span-full">
      {% include '_includes/sectionTitleChip.twig' with {
        title: workTitle,
        chipLabel: workCtaChip.label ?? 'View All',
        chipLink: workCtaChip.url,
        classes: 'mb-16'
      } only %}
    </div>
  {% endif %}

  {% include '_includes/workGrid' with { entries: entry.workEntries ?? [] } only %}

  <div class="relative col-span-full mb-16 h-[300vh]">
    <about-huw-scene class="sm-down:w-screen sm-down:-ml-16 sticky top-0"></about-huw-scene>
  </div>

  {% include '_includes/workGrid' with { entries: entry.workEntries ?? [] } only %}
{% endblock %}
